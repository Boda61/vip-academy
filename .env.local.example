# Supabase Configuration
# Replace these placeholders with your actual Supabase project credentials in .env.local
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Secret Display Password / Token for the Academy QR Display Screen (Server-side ONLY)
# Used to authenticate the in-center laptop/screen before generating active QR codes
QR_DISPLAY_SECRET=your-secure-display-secret-here

# Supabase Service Role Key (Required ONLY for server-side protected RPCs like get_or_create_active_qr_token)
# NEVER expose this key in client-side code (do NOT prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Application URL (used for QR code registration links)
# For local LAN testing, use your machine's local IP, e.g.: http://192.168.1.7:3000
# For production, use the deployed domain
NEXT_PUBLIC_APP_URL=http://192.168.1.7:3000

# Google Sheets Synchronization Service Account Configuration (Server-side ONLY)
# Never expose these keys to the client or commit them to source control
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account-email@project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=1G6uUU2t9d9R_ymqSFvCyvgZUff1MivfExCkLXcqMF4A
GOOGLE_SHEETS_RANGE=Registrations!A:K
